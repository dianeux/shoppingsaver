# Local: PGlite socket server started by `npm run db`.
# Production: Neon pooled connection string (…-pooler.….neon.tech/…?sslmode=require).
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/postgres

# Used only by the nightly pipeline for composition extraction fallback (Claude Haiku 4.5).
# Leave empty to run parser-only; unparseable items are then marked extraction_failed.
ANTHROPIC_API_KEY=

# Hard cap on LLM spend per full index run, in US dollars (PRD ch.4 / ch.11).
LLM_BUDGET_USD=2

# Coverage threshold for L2 pages (PRD: 4). Lower it locally while few brands are wired up.
# MIN_BRANDS_PER_L2=1
